---
import {
  getCollection,
  render,
  type CollectionEntry,
} from "astro:content";

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

export async function getStaticPaths() {
  const entries = await getCollection(
    "study",
    ({ data, id }) => !data.draft && id.startsWith("ko/")
  );

  return entries.map(entry => ({
    params: {
      id: entry.id.replace(/^ko\//, ""),
    },
    props: {
      entry,
    },
  }));
}


interface Props {
  entry: CollectionEntry<"study">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const categoryLabels: Record<string, string> = {
  cuda: "CUDA",
  gpu: "GPU",
  "gpu-architecture": "GPU Architecture",
  "sparse-matrix": "Sparse Matrix",
  "ai-systems": "AI Systems",
  papers: "Papers",
};

const folderName = entry.id.split("/")[1];

const category =
  categoryLabels[folderName] ??
  folderName
    .split("-")
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");

---

<Layout
  title={`${entry.data.title} | ${config.site.title}`}
  description={entry.data.description}
>
  <Header />

  <Main class="app-layout" pageTitle="">
    <article
        data-pagefind-body
        class="prose mx-auto max-w-3xl dark:prose-invert"
        >
      <header class="mb-8">
        <p class="text-accent font-medium">
          {category}
        </p>

        <h1>{entry.data.title}</h1>

        <p>{entry.data.description}</p>

        <time datetime={entry.data.pubDatetime.toISOString()}>
          {
            entry.data.pubDatetime.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })
          }
        </time>
      </header>

      <Content />

      <section class="mt-10">

      <script 
              is:inline
              src="https://giscus.app/client.js"
              data-repo="acornjelly2205/acornjelly2205.github.io"
              data-repo-id="R_kgDOTU_Ysg"
              data-category="Comments"
              data-category-id="DIC_kwDOTU_Yss4DGEF1"
              data-mapping="pathname"
              data-strict="0"
              data-reactions-enabled="1"
              data-emit-metadata="0"
              data-input-position="bottom"
              data-theme="preferred_color_scheme"
              data-lang="ko"
              data-loading="lazy"
              crossorigin="anonymous"
              async>
      </script>
    </section>

    <hr class="my-8 border-dashed" />


    </article>
  </Main>

  <Footer />
</Layout>