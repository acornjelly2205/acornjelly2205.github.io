---
import {
  getCollection,
  render,
  type CollectionEntry,
} from "astro:content";

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

export async function getStaticPaths() {
  const entries = await getCollection(
    "study",
    ({ data, id }) => !data.draft && id.startsWith("en/")
  );

  return entries.map(entry => ({
    params: {
      id: entry.id.replace(/^en\//, ""),
    },
    props: {
      entry,
    },
  }));
}


interface Props {
  entry: CollectionEntry<"study">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const categoryLabels: Record<string, string> = {
  cuda: "CUDA",
  gpu: "GPU",
  "gpu-architecture": "GPU Architecture",
  "sparse-matrix": "Sparse Matrix",
  "ai-systems": "AI Systems",
  papers: "Papers",
};

const folderName = entry.id.split("/")[1];

const category =
  categoryLabels[folderName] ??
  folderName
    .split("-")
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");

---

<Layout
  title={`${entry.data.title} | ${config.site.title}`}
  description={entry.data.description}
>
  <Header />

  <Main class="app-layout" pageTitle="">
    <article
      data-pagefind-body
      class="prose mx-auto max-w-3xl dark:prose-invert"
    >
      <header class="mb-8">
        <p class="text-accent font-medium">
          {category}
        </p>

        <h1>{entry.data.title}</h1>

        <p>{entry.data.description}</p>

        <time datetime={entry.data.pubDatetime.toISOString()}>
          {
            entry.data.pubDatetime.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })
          }
        </time>
      </header>

      <Content />
    </article>
  </Main>

  <Footer />
</Layout>